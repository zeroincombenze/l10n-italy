<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_create_ddt" model="ir.ui.view">
        <field name="name">Create DdT</field>
        <field name="model">wizard.create.ddt</field>
        <field name="arch" type="xml">
            <form string="Create DdT">
                <footer>
                    <button
                        name="create_ddt"
                        string="Create DdT"
                        type="object"
                        class="oe_highlight"
                    />
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <act_window
        name="Create DdT"
        res_model="wizard.create.ddt"
        src_model="sale.order"
        view_mode="form"
        target="new"
        key2="client_action_multi"
        id="action_create_ddt"
    />

</odoo>
