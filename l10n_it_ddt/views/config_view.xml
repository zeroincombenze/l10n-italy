<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ddt_config_settings" model="ir.ui.view">
        <field name="name">view.ddt.config.settings</field>
        <field name="model">account.config.settings</field>
        <field name="inherit_id" ref="account.view_account_config_settings"/>
        <field name="arch" type="xml">
            <xpath expr="/form/group[6]" position="after">
                <separator string="Delivery + Invoice configuration"/>
                <group name="delivery_invoice">
                    <div>
                        <div>
                            <label for="keep_pick_state_from_ddt"/>
                            <field name="keep_pick_state_from_ddt"/>
                        </div>
                        <div>
                            <label for="delivery_price_policy"/>
                            <field name="delivery_price_policy"/>
                        </div>
                    </div>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
