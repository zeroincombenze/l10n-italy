<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="product_template_form_view_ddt_invoicing" model="ir.ui.view">
        <field name="name">product.template.form.ddt.invoicing</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale.product_template_form_view_invoice_policy"/>
        <field name="arch" type="xml">
            <field name="invoice_policy" position="after">
                <field
                    name="ddt_invoice_exclude"
                    attrs="{'invisible':[('type','!=','service')]}"
                />
            </field>
        </field>
    </record>

    <record id="product_template_form_view_delivery" model="ir.ui.view">
        <field name="name">product.template.form.delivery</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="type" position="after">
                <field name="is_delivery"/>
            </field>
        </field>
    </record>

</odoo>
