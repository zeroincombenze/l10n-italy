#. module: l10n_it_ddt
#: model:mail.template,body_html:l10n_it_ddt.email_template_edi_ddt
msgid ""
"\n"
"            <p>Dear ${object.partner_id.name},</p>\n"
"            <p>Here is your document\n"
"              %if object.date:\n"
"              of <strong>${object.date},</strong>\n"
"              % endif\n"
"              %if object.date_done:\n"
"              with shipping date\n"
"                <strong>${object.date_done}</strong>\n"
"                       %endif\n"
"                       from ${object.company_id.name}.\n"
"            </p>\n"
"            <p>You can reply to this email if you have any questions.</p>\n"
"            <p>Thank you.</p>\n"
"              "
msgstr ""
"\n"
"            <p>Dear ${object.partner_id.name},</p>\n"
"            <p>Here is your documento\n"
"              %if object.date:\n"
"              of <strong>${object.date},</strong>\n"
"              % endif\n"
"              %if object.date_done:\n"
"              with consegna data\n"
"                <strong>${object.date_done}</strong>\n"
"                       %endif\n"
"                       da ${object.company_id.name}.\n"
"            </p>\n"
"            <p>You can reply a this e-mail if you have qualunque questions.</p>\n"
"            <p>Thank you.</p>\n"
"              "

