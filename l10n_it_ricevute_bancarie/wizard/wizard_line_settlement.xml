<?xml version="1.0" encoding="utf-8" ?>
<odoo>

        <record id="line_settlement_view" model="ir.ui.view">
            <field name="name">Set C/O line settlements</field>
            <field name="model">wizard.line.settlement</field>
            <field name="arch" type="xml">
            <form string="Set C/O line settlements">
                <footer>
                    <button string="Settlement"
                            name="line_settlement"
                            type="object"
                            default_focus="1"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
            </field>
        </record>

        <record id="action_line_settlement" model="ir.actions.act_window">
            <field name="name">Set C/O line settlements</field>
            <field name="res_model">wizard.line.settlement</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
           <field name="view_id" ref="line_settlement_view"/>
           <field name="target">new</field>
        </record>

        <record model="ir.values" id="line_settlement_values">
            <field name="model_id" ref="account.model_account_move_line" />
            <field name="name">Set C/O line settlements</field>
            <field name="key2">client_action_multi</field>
            <field name="value"
                   eval="'ir.actions.act_window,' + str(ref('action_line_settlement'))" />
            <field name="key">action</field>
            <field name="model">account.move.line</field>
        </record>

</odoo>
