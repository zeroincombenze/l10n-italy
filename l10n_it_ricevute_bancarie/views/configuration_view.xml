<?xml version="1.0" ?>
<odoo>
    <data>
        <!-- ====================================================== -->
        <!-- 				CONFIGURAZIONE RIBA FORM 				-->
        <!-- ====================================================== -->
        <record model="ir.ui.view" id="view_riba_configuration_form">
            <field name="name">riba.configuration.form</field>
            <field name="model">riba.configuration</field>
            <field name="arch" type="xml">
                <form string="Ri.Ba. - Configurazione">
                    <group>
                        <field name="name" />
                        <field name="type" />
                        <field
                            name="bank_id"
                            domain="[('partner_id.ref_company_ids', 'in', [company_id])]"
                        />
                        <field
                            name="company_id"
                            widget="selection"
                            groups="base.group_multi_company"
                        />
                    </group>
                    <group
                        string="Salvo Buon Fine / Dopo Incasso"
                        colspan="4"
                        col="4"
                    >
                        <separator colspan="4" string="Acceptance (debit / credit)" />
                        <field
                            name="acceptance_account_id"
                            attrs="{'required':[('type','=','sbf')], 'invisible': [('type','!=','sbf')]}"
                        />

                        <field
                            name="acceptance_journal_id"
                            attrs="{'required': True}"
                        />
                        <separator colspan="4" string="Accreditation (debit / credit)"
                                   attrs="{'invisible': [('type','!=','sbf')]}"/>
                        <field name="accreditation_account_debit_id"
                               attrs="{'invisible': [('type','!=','sbf')]}"/>
                        <field name="accreditation_account_credit_id"
                               attrs="{'invisible': [('type','!=','sbf')]}"/>
                        <field name="accreditation2_account_debit_id"
                               attrs="{'invisible': [('type','!=','sbf')]}"/>
                        <field name="accreditation2_account_credit_id"
                               attrs="{'invisible': [('type','!=','sbf')]}"/>
                        <field name="bank_expense_account_id"
                               attrs="{'invisible': [('type','!=','sbf')]}"/>
                        <field name="accreditation_journal_id"
                               attrs="{'invisible': [('type','!=','sbf')]}"/>

                        <separator colspan="4" string="Settlement"
                                   attrs="{'invisible': [('type','!=','sbf')]}"/>
                        <field name="liquidity_account_id" />
                        <field name="settlement_journal_id"
                               attrs="{'invisible': [('type','!=','sbf')]}"/>

                        <separator colspan="4" string="Unsolved (debit / credit)"
                                   attrs="{'invisible': [('type','!=','sbf')]}"/>
                        <field name="overdue_account_debit_id"
                               attrs="{'invisible': [('type','!=','sbf')]}"/>
                        <field name="unsolved_journal_id"
                               attrs="{'invisible': [('type','!=','sbf')]}"/>
                        <field name="overdue_expenses_account_id"
                               attrs="{'invisible': [('type','!=','sbf')]}"/>

                    </group>
                </form>
            </field>
        </record>
        <!-- ====================================================== -->
        <!-- 				CONFIGURAZIONE RIBA ACTION				-->
        <!-- ====================================================== -->
        <record model="ir.actions.act_window" id="action_riba_configuration">
                <field name="name">Ri.Ba. - Configuration</field>
                <field name="type">ir.actions.act_window</field>
                <field name="res_model">riba.configuration</field>
                <field name="view_type">form</field>
                <field name="view_mode">tree,form</field>
                <!--field name="view_id" ref="view_riba_configuration_form"/-->
        </record>
        <!-- ====================================================== -->
        <!-- 				CONFIGURAZIONE RIBA MENU 				-->
        <!-- ====================================================== -->
        <menuitem
            action="action_riba_configuration"
            id="menu_riba_configuration"
            name="Ri.Ba. Configuration"
            parent="account.account_management_menu"
        />
    </data>
</odoo>
